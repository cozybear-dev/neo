# Global LLM (DSH adapters). Default = DeepSeek.
NEO_LLM_PROVIDER=deepseek
NEO_LLM_MODEL=deepseek-v4-flash
NEO_LLM_API_KEY=
# NEO_LLM_BASE_URL=                 # required when PROVIDER=custom
# NEO_LLM_API=openai-completions
# NEO_LLM_API_KEY_ENV=NEO_LLM_API_KEY
# NEO_LLM_REASONING_EFFORT=

# Optional parent-chat model. Empty falls back to NEO_LLM_*.
# New chats pick this up. An existing chat keeps its pinned model.
# NEO_LLM_ORCHESTRATOR_PROVIDER=anthropic
# NEO_LLM_ORCHESTRATOR_MODEL=claude-sonnet-4-5
# NEO_LLM_ORCHESTRATOR_API_KEY=
# NEO_LLM_ORCHESTRATOR_BASE_URL=
# NEO_LLM_ORCHESTRATOR_API=openai-completions
# NEO_LLM_ORCHESTRATOR_API_KEY_ENV=
# NEO_LLM_ORCHESTRATOR_REASONING_EFFORT=

# Optional model for every delegate() child (planner, swarm, judge, specialists).
# Empty means children inherit the parent. A role is active only when MODEL is set.
# NEO_LLM_WORKHORSE_PROVIDER=deepseek
# NEO_LLM_WORKHORSE_MODEL=deepseek-v4-flash
# NEO_LLM_WORKHORSE_API_KEY=
# NEO_LLM_WORKHORSE_BASE_URL=
# NEO_LLM_WORKHORSE_API=openai-completions
# NEO_LLM_WORKHORSE_API_KEY_ENV=
# NEO_LLM_WORKHORSE_REASONING_EFFORT=

# Subscription OAuth (chatgpt / claude / grok). No API key. MODEL is optional.
# Uncomment the matching /host-auth mount in docker-compose.yml first.
# NEO_LLM_PROVIDER=chatgpt
# NEO_LLM_OAUTH_CHATGPT_FILE=/host-auth/codex/auth.json
# NEO_LLM_OAUTH_CLAUDE_FILE=/host-auth/claude/.credentials.json
# NEO_LLM_OAUTH_GROK_FILE=/host-auth/grok/auth.json

EXA_API_KEY=
GITHUB_TOKEN=
PDCP_API_KEY=
HACKERONE_API_TOKEN=
# Hosts each chat may assess. The UI copies this list onto the task it opens.
NEO_ALLOWLIST=*.lab.internal,juice-shop,lab-app
# fast skips plan approval. thorough waits for operator approval.
NEO_MODE_DEFAULT=thorough
# Generate three independent secrets (openssl rand -hex 32); no defaults.
NEO_DB_PASSWORD=
NEO_CONTROL_ADMIN_TOKEN=
NEO_CONTROL_BROKER_TOKEN=
# Leave both empty. The first message in a chat opens a task.
# Set both only to bind every chat to a task you created yourself.
NEO_TASK_ID=
NEO_TASK_TOKEN=
# Worker commands are offline by default. lab allows only owned lab containers.
NEO_EXEC_NETWORK=none
# HTTP lab callbacks are relayed through broker. Public DNS OAST is unavailable.
INTERACTSH_DOMAIN=oast.neo.internal
INTERACTSH_CALLBACK_DOMAIN=oast.neo.internal
INTERACTSH_TOKEN=
# DSH_PERMISSION_MODE=danger-full-access
# BROWSER_CDP_URL=http://browser:9222
